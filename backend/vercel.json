{
  "version": 2,
  "bunVersion": "1.x",
  "redirects": [
    {
      "source": "/",
      "destination": "/health",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/nudges/dispatch",
      "schedule": "0 2 * * *"
    }
  ]
}
