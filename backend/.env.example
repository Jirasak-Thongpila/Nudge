# Server Port
PORT=3000

# Database Connection (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nudge

# LINE Messaging API (LINE OA Developer Integration)
# Obtain from LINE Developers Console -> Messaging API Channel -> Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=
# Obtain from LINE Developers Console -> Basic settings tab
LINE_CHANNEL_SECRET=
# Obtain from LINE Developers Console -> LIFF tab (LIFF ID)
LINE_LIFF_ID=

# Gemini API (AI Natural Language Task Parser)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Shared secret for the Action Nudge scheduler (cron -> POST /nudges/dispatch)
# Generate anything long and random, e.g. `openssl rand -hex 32`
NUDGE_DISPATCH_KEY=


